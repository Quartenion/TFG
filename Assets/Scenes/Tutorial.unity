MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1567811266}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d8a0f5cff35ef247bb32241f5356a00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CourseBuilder
  floorPrefab: {fileID: 6468749736777635400, guid: 82843fa014a0f1348a520334db48b000, type: 3}
  endPrefab: {fileID: 4843750200849720215, guid: a9148ca4dbd53a543b82f1aef47e6e01, type: 3}
  endHeightOffset: -0.3
  obstacles:
  - titleEs: Salto
    titleEn: Jump
    prefab: {fileID: 7303118272052442045, guid: 5b61bb808b2fbd049bcd000f93a8ab97, type: 3}
    segments: 1
    reps: 3
    alternateSides: 0
    inStudy: 1
    floorAfter: 0
    kayakRaise: 0.5
    actions:
    - key: 1
      beat: 0
      side: 0
      explainEs: "Durante tu trayecto encontrar\xE1s obst\xE1culos que puedes saltar,
        como este."
      explainEn: Along the way you will find obstacles you can jump over, like this
        one.
    tipEs: "Salta justo al llegar al bloque, cuando la nota llegue al centro del
      monitor del coraz\xF3n."
    tipEn: Jump right as you reach the block, when the note reaches the centre of
      the heart monitor.
  - titleEs: Doble salto
    titleEn: Double jump
    prefab: {fileID: 5818584248247319039, guid: 89473fd63c31a704db75fce438700d96, type: 3}
    segments: 1
    reps: 3
    alternateSides: 0
    inStudy: 1
    floorAfter: 0
    kayakRaise: 0.5
    actions:
    - key: 1
      beat: 0
      side: 0
      explainEs: 
      explainEn: 
    - key: 7
      beat: 0.5
      side: 0
      explainEs: "Este obst\xE1culo es m\xE1s alto: en el aire, vuelve a saltar para
        hacer un doble salto."
      explainEn: 'This obstacle is taller: jump again in the air to double jump.'
    tipEs: "Salta al llegar y, medio beat despu\xE9s, vuelve a saltar en el aire."
    tipEn: Jump as you arrive and jump again in the air half a beat later.
  - titleEs: "Ca\xEDda en picado"
    titleEn: Slam
    prefab: {fileID: 8059213906976590943, guid: f85826953586fc7479ab8d9200a0b095, type: 3}
    segments: 1
    reps: 3
    alternateSides: 0
    inStudy: 1
    floorAfter: 0
    kayakRaise: 0.5
    actions:
    - key: 1
      beat: 0
      side: 0
      explainEs: 
      explainEn: 
    - key: 4
      beat: 0.5
      side: 0
      explainEs: En el aire puedes caer en picado (slam) para bajar al instante.
      explainEn: In the air you can slam down to land instantly.
    tipEs: "Salta el bloque y, medio beat despu\xE9s, cae en picado para no darte
      con el techo."
    tipEn: Jump the block and, half a beat later, slam down so you don't hit the
      ceiling.
  - titleEs: Deslizarse
    titleEn: Slide
    prefab: {fileID: 2633165345495229486, guid: 225b59c0ee8b0a04db6502352ca449bd, type: 3}
    segments: 1
    reps: 3
    alternateSides: 0
    inStudy: 1
    floorAfter: 0
    kayakRaise: 0.5
    actions:
    - key: 3
      beat: 0
      side: 0
      explainEs: "Cuando el techo est\xE9 demasiado bajo, desl\xEDzate por debajo."
      explainEn: When the ceiling is too low, slide under it.
    tipEs: "Desl\xEDzate justo al llegar al muro bajo, ya que el deslizamiento dura
      poco."
    tipEn: 'Slide right as you reach the low wall: the slide is short.'
  - titleEs: Dash
    titleEn: Dash
    prefab: {fileID: 428530028489407254, guid: 95ed428b7ca73c94c9b809f320cd612c, type: 3}
    segments: 1
    reps: 3
    alternateSides: 1
    inStudy: 1
    floorAfter: 0
    kayakRaise: 0.5
    actions:
    - key: 1
      beat: 2
      side: -1
      explainEs: Para esquivar este muro, primero salta hacia la IZQUIERDA manteniendo
        pulsada la A.
      explainEn: 'To dodge this wall, first jump to the LEFT: hold A while you jump.'
    - key: 2
      beat: 3
      side: -1
      explainEs: Ahora, en el aire, haz un DASH hacia ese mismo lado, que te impulsa
        de golpe.
      explainEn: 'Now, in the air, DASH to that side: it pushes you in an instant.'
    tipEs: "Salta hacia el lado del hueco y, en el beat siguiente, mant\xE9n esa
      direcci\xF3n y pulsa la E."
    tipEn: Jump towards the side of the gap and, on the next beat, hold that direction
      and press E.
  - titleEs: Romper puertas
    titleEn: Break doors
    prefab: {fileID: 690194488817319735, guid: 234cd83e0b58235459a124bf33b070f9, type: 3}
    segments: 1
    reps: 3
    alternateSides: 0
    inStudy: 1
    floorAfter: 0
    kayakRaise: 0.5
    actions:
    - key: 6
      beat: 0
      side: 0
      explainEs: Algunas puertas se pueden romper si pulsas la Q justo al llegar
        a ellas.
      explainEn: 'Some doors can be broken: press Q just as you reach them.'
    tipEs: Pulsa la Q justo al llegar a la puerta, en el beat.
    tipEn: Press Q just as you reach the door, on the beat.
  - titleEs: Tirolina
    titleEn: Zipline
    prefab: {fileID: 5057192006479819315, guid: a1fa2e7b5dc3567458e5e1c10dae4af4, type: 3}
    segments: 4
    reps: 1
    alternateSides: 0
    inStudy: 0
    floorAfter: 0
    kayakRaise: 0.5
    actions:
    - key: 1
      beat: 0
      side: 0
      explainEs: 
      explainEn: 
    - key: 5
      beat: 1
      side: 0
      explainEs: "Eng\xE1nchate a la tirolina para cruzar."
      explainEn: Grab the zipline to get across.
    tipEs: "Salta al final del suelo y eng\xE1nchate a la tirolina mientras est\xE1s
      en el aire."
    tipEn: Jump at the end of the floor and grab the zipline in the air.
  - titleEs: Paredes
    titleEn: Walls
    prefab: {fileID: 8132426019449963481, guid: f8eb21d894c99e942a6d5ca40ae03a88, type: 3}
    segments: 4
    reps: 1
    alternateSides: 0
    inStudy: 0
    floorAfter: 0
    kayakRaise: 0.5
    actions:
    - key: 1
      beat: 0
      side: -1
      explainEs: "Salta hacia la pared para correr por ella y, desde ah\xED, salta
        en cada beat para impulsarte hasta la pared de enfrente."
      explainEn: Jump towards the wall to run along it and, from the wall, jump on
        every beat to push off to the opposite one.
    - key: 1
      beat: 1
      side: 1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 2
      side: -1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 3
      side: 1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 4
      side: -1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 5
      side: 1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 6
      side: -1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 7
      side: 1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 8
      side: -1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 9
      side: 1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 10
      side: -1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 11
      side: 1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 12
      side: -1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 13
      side: 1
      explainEs: 
      explainEn: 
    - key: 1
      beat: 14
      side: -1
      explainEs: 
      explainEn: 
    - key: 1
